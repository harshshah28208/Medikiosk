# ============================================
# MediKiosk Environment Configuration
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://medikiosk:medikiosk_dev_2026@localhost:5432/medikiosk?schema=public"

# JWT
JWT_SECRET="medikiosk-jwt-secret-change-in-production-2026"
JWT_EXPIRY="24h"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# AI Provider (Gemini)
# Leave empty to use MockAIProvider
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OCR Provider
# Leave empty to use MockOCRProvider
OCR_API_KEY=""

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
